# Configuration du serveur de synchronisation.
#
#     cp .env.exemple .env
#     chmod 600 .env        # il contient le mot de passe de la base
#
# Ce fichier ne doit JAMAIS être versionné : .gitignore l'écarte déjà.
# En production, ces mêmes variables peuvent venir de systemd
# (EnvironmentFile=) plutôt que d'un fichier .env — voir README.md.

# --- Serveur ---------------------------------------------------------

# Adresse d'écoute. 127.0.0.1 = accessible seulement depuis la machine
# elle-même (le bon réglage derrière un proxy). Mettez 0.0.0.0 en sachant
# que le serveur devient alors joignable depuis tout le réseau.
SYNC_ADRESSE=127.0.0.1
SYNC_PORT=8080

# Dossier où sont rangés les projets, un sous-dossier par identifiant.
# C'est CE dossier qu'il faut sauvegarder, avec la base.
SYNC_RACINE=/var/lib/editeur-sync/projets

# --- Base de données -------------------------------------------------

DB_HOTE=127.0.0.1
DB_PORT=3306
DB_NOM=editeur_sync
DB_UTILISATEUR=editeur_sync
DB_MOTDEPASSE=a-remplacer
